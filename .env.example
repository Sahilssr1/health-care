DATABASE_URL=postgresql://bhc:CHANGE_ME@localhost:5432/bhc?schema=public
POSTGRES_USER=bhc
POSTGRES_DB=bhc
POSTGRES_PASSWORD=CHANGE_ME
APP_ORIGIN=http://localhost:3000
# Set true ONLY behind HTTPS. Production requires true.
COOKIE_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Single trusted nginx hop only; do not enable on a directly exposed app.
TRUST_PROXY=false
# Defaults to the verified private registrations Sheet in lib/google-sheets-target.json.
GOOGLE_SHEETS_ID=1yaetiQgYi6LGIHBAwY3ooE-8XhRboxaRCxX2wWIr6f0
GOOGLE_SHEETS_TAB=Registrations
# Server-only credentials. Never commit or put these in public/.
# Local worker: an absolute path to the organiser's service-account JSON key.
GOOGLE_APPLICATION_CREDENTIALS=
# Docker's optional sheets profile mounts this file read-only into the worker.
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json

# Server-only competition OTP encryption/HMAC key. Generate once with 32 random bytes (64 hex characters).
COMPETITION_AUTH_SECRET=
